<?xml version="1.0" encoding="utf-8"?>
<!--
  Boot splash: the wordmark with a loading indicator under it. Replaces the bundled intro video,
  which was the upstream emulator's branding and cost an mp4 decode on the slowest moment of the
  app's life.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/boot_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0D">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/boot_splash_logo"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/namco_2x6"
            android:contentDescription="@string/app_name" />

        <ProgressBar
            android:id="@+id/boot_splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFC8202F"
            android:indeterminateTintMode="src_in" />

    </LinearLayout>

</FrameLayout>
