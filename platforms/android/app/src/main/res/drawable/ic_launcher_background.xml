<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher ground. NAMCO System 246/256 red rather than the console launcher's blue: the
  icon is the first thing that says which emulator this is, and on a home screen it is competing
  with a wallpaper, so it carries the colour rather than the mark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#6E0B14"
        android:centerColor="#A5121F"
        android:endColor="#C8202F" />
</shape>
