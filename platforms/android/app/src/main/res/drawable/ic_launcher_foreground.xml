<?xml version="1.0" encoding="utf-8"?>
<!--
  The NAMCO System 246/256 wordmark, on the adaptive icon's foreground layer.

  The insets place it inside the centre 72dp of the 108dp layer, which is the only region every
  launcher mask is guaranteed to show, and they keep the source image's 4.93:1 aspect: 76dp wide
  gives 15.4dp of height, so the top and bottom insets are (108 - 15.4) / 2. Getting that ratio
  wrong is what stretches a wordmark, and a stretched wordmark is worse than no wordmark.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="16dp"
        android:right="16dp"
        android:top="46dp"
        android:bottom="46dp">
        <bitmap
            android:src="@drawable/namco_2x6"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
